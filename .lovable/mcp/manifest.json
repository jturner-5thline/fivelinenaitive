            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "assignee": {
              "type": "string",
              "maxLength": 200
            },
            "deal_id": {
              "type": "string",
              "format": "uuid"
            },
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "company_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "complete_task",
