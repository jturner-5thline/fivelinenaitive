      {
        "name": "query_insights_dataset",
        "title": "Query any Insights source dataset",
        "description": "Read-only escape hatch for the Insights page: query any of its underlying datasets directly when no purpose-built metric tool covers the question. Allowed datasets: deals, deal_lenders, deal_pipelines, deal_stage_history, deal_milestones, deal_computed_metrics, deal_stage_durations, deal_stage_transitions, outstanding_items, tasks, activity_logs, contacts, crm_companies, master_lenders, custom_metrics, insights_metric_targets, metric_manual_inputs, dashboard_grid_layouts, dashboard_layouts, quickbooks_invoices, quickbooks_customers, quickbooks_payments, quickbooks_expenses, quickbooks_bills, quickbooks_reports, qbo_pnl_snapshots, qbo_cashflow_snapshots, claap_meetings, team_interaction_metrics. Supply optional column selection, filters (column + operator + value), ordering, and a row limit. Everything runs through the signed-in user's row-level security, so results match exactly what that user sees in the UI. Aggregate the returned rows yourself.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string",
              "enum": [
                "deals",
                "deal_lenders",
                "deal_pipelines",
                "deal_stage_history",
                "deal_milestones",
                "deal_computed_metrics",
                "deal_stage_durations",
                "deal_stage_transitions",
                "outstanding_items",
                "tasks",
                "activity_logs",
                "contacts",
                "crm_companies",
                "master_lenders",
                "custom_metrics",
                "insights_metric_targets",
                "metric_manual_inputs",
                "dashboard_grid_layouts",
                "dashboard_layouts",
                "quickbooks_invoices",
                "quickbooks_customers",
                "quickbooks_payments",
                "quickbooks_expenses",
                "quickbooks_bills",
                "quickbooks_reports",
                "qbo_pnl_snapshots",
                "qbo_cashflow_snapshots",
                "claap_meetings",
                "team_interaction_metrics"
              ]
            },
            "columns": {
              "type": "string",
              "maxLength": 1000,
              "description": "Comma-separated column list; defaults to all columns."
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "like",
                      "ilike",
                      "is",
                      "in"
                    ],
                    "default": "eq"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "column",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "order_by": {
              "type": "string",
              "maxLength": 80
            },
            "ascending": {
              "type": "boolean",
              "default": false
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200
            }
          },
          "required": [
            "dataset"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
