              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "closing_date",
                "dashboard_closing_date"
              ],
              "default": "created_at",
              "description": "Which date column the timeframe window applies to."
            },
            "from": {
              "type": "string",
              "maxLength": 40,
              "description": "ISO date/timestamp lower bound (inclusive)."
            },
            "to": {
              "type": "string",
              "maxLength": 40,
              "description": "ISO date/timestamp upper bound (exclusive)."
